{
  "model": {
    "io_channels": 64,
    "embed_dim": 768,
    "depth": 24,
    "num_heads": 12,
    "head_dim": 64,
    "cond_token_dim": 512,
    "global_cond_dim": 768,
    "global_cond_type": "adaLN",
    "cross_attend": true,
    "diffusion_objective": "rectified_flow",
    "num_languages": 2,
    "languages": ["en", "ja"]
  },
  "conditioning": {
    "content_encoder": {
      "model_name": "openai/whisper-base",
      "layer_index": 6,
      "output_dim": 512,
      "frame_rate_hz": 50,
      "frozen": true
    },
    "speaker_encoder": {
      "model_name": "speechbrain/spkrec-ecapa-voxceleb",
      "output_dim": 192,
      "frozen": true
    }
  },
  "training": {
    "max_steps": 300000,
    "batch_size": 256,
    "micro_batch_size": 16,
    "gradient_accumulation_steps": 16,
    "learning_rate": 1.5e-4,
    "optimizer": "AdamW",
    "weight_decay": 0.01,
    "warmup_steps": 2000,
    "ema_decay": 0.9999,
    "mixed_precision": "bf16",
    "max_audio_length": 160000,
    "num_workers": 8,
    "gradient_clip_norm": 1.0
  },
  "inference": {
    "solver": "euler",
    "num_steps": 10
  }
}
